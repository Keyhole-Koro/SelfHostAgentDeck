{
  "name": "agent-deck",
  "version": "0.2.0",
  "description": "Every Claude Code and Codex session on one page, from your phone too: what waits on you, the conversation, one-tap answers, push notifications, new sessions, and which session changed what",
  "keywords": [
    "claude-code",
    "codex",
    "coding-agents",
    "agents",
    "inbox",
    "remote-control",
    "passkey",
    "web-push",
    "herdr",
    "git",
    "diff",
    "attribution"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "agent-deck": "dist/cli.js",
    "agent-deck-hook": "dist/hook-entry.js",
    "agent-deck-statusline": "dist/statusline-entry.js",
    "agent-diff": "dist/cli.js",
    "agent-diff-hook": "dist/hook-entry.js",
    "agent-diff-statusline": "dist/statusline-entry.js"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp src/viewer.html src/markdown.js src/sw.js dist/",
    "prepack": "npm run build",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc -p .",
    "screenshots": "node scripts/screenshots.ts"
  },
  "dependencies": {
    "@simplewebauthn/server": "^14.0.3",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "playwright": "^1.63.0",
    "typescript": "7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Keyhole-Koro/SelfHostAgentDeck.git"
  },
  "homepage": "https://github.com/Keyhole-Koro/SelfHostAgentDeck#readme",
  "bugs": {
    "url": "https://github.com/Keyhole-Koro/SelfHostAgentDeck/issues"
  },
  "author": "Keyhole-Koro",
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ]
}
